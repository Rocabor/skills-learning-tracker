# Copy to .env and fill in your values.

# Local development: leave TURSO_DATABASE_URL unset to use a local libSQL file (data/skilltrack.db).
# Production (Vercel): create a Turso database and set both values.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# Secret used to sign JWT auth tokens. Set a long random string in production.
JWT_SECRET=

# Google Gemini API key for AI practice insights. Optional: without it, a local fallback coach is used.
GEMINI_API_KEY=MY_GEMINI_API_KEY
